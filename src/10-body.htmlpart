<div id="app">

  <header id="top">
    <div class="brand">포뮬라랩</div>
    <div class="topmid">
      <select id="selProd" title="제품군"></select>
      <button id="btnBatch" class="btn" title="배치 규모">1 kg</button>
    </div>
    <div class="grow"></div>
    <button id="btnLearn" class="btn wide-only" title="학습 과정">✦ 학습</button>
    <button id="btnRun" class="btn pri">제조</button>
    <button id="btnMenu" class="btn ico" title="설정" aria-label="설정">≡</button>
  </header>

  <div id="main">

    <!-- 처방 / 공정 -->
    <section class="pane active" id="p-mid" data-col="1">
      <div id="misStrip" hidden></div>
      <div class="pane-hd">
        <div class="seg wide-only" id="midtabs"></div>
        <h2 id="midTitle" class="narrow-only">처방</h2>
        <div class="grow" style="flex:1"></div>
        <div id="midTools" style="display:flex;gap:6px"></div>
      </div>
      <div class="pane-bd" id="midBody"></div>
      <div class="pane-ft" id="midFoot"></div>
    </section>

    <!-- 결과 -->
    <section class="pane" id="p-res" data-col="2">
      <div class="pane-hd">
        <h2>결과</h2>
        <span id="resSub" style="font-size:12.5px;color:var(--ink-3)"></span>
        <div class="grow" style="flex:1"></div>
        <button class="btn sm" id="btnRepeat" title="같은 조건으로 5배치를 돌려 편차를 본다">편차 ×5</button>
      </div>
      <div class="pane-bd" id="resBody"></div>
    </section>

  </div>

  <nav id="nav">
    <button data-go="form"  aria-selected="true"><span class="g">▤</span>처방</button>
    <button data-go="proc"  aria-selected="false"><span class="g">⚗</span>공정</button>
    <button data-go="res"   aria-selected="false"><span class="g">◐</span>결과</button>
    <button data-go="learn" aria-selected="false"><span class="g">✦</span>학습</button>
  </nav>

</div>

<!-- 원료 고르기 -->
<div id="picker" class="ovl" hidden>
  <div class="box">
    <div class="phd">
      <b class="wide-only">원료</b>
      <div class="srch">
        <span class="mag">⌕</span>
        <input id="q" type="search" placeholder="원료 검색 — 한글 · INCI · 기능" autocomplete="off">
        <button class="clr" id="qClear" aria-label="지우기" hidden>✕</button>
      </div>
      <button class="btn" id="pickDone">완료</button>
    </div>
    <div class="chips" id="cats"></div>
    <div class="ilist" id="ilist"></div>
    <div class="pane-ft" style="display:flex;align-items:center;gap:10px">
      <span id="icount" style="font-size:12.5px;color:var(--ink-3)"></span>
      <span id="ptotal" style="font-size:12.5px;color:var(--ink-3);margin-left:auto"></span>
    </div>
  </div>
</div>

<!-- 학습 -->
<div id="learn" class="ovl" hidden>
  <div class="box">
    <div class="phd">
      <b>✦ 학습 과정</b>
      <span id="learnProg" style="font-size:13px;color:var(--ink-3);font-family:var(--mono)"></span>
      <div style="flex:1"></div>
      <button class="btn" id="learnDone">닫기</button>
    </div>
    <div class="ilist" id="learnBody"></div>
  </div>
</div>

<!-- 제조 연출 -->
<div id="brew" hidden>
  <div class="brewbox">
    <div class="brewtop">
      <div class="brewttl" id="brewTtl">제조 준비</div>
      <button class="btn sm" id="brewSkip">건너뛰기</button>
    </div>
    <div class="brewstage" id="brewStage"></div>
    <div class="brewbar"><i id="brewFill"></i></div>
    <div class="brewfoot" id="brewFoot"></div>
  </div>
</div>
