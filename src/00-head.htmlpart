<meta charset="utf-8">
<title>포뮬라랩 — 화장품 제조 시뮬레이터</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans+KR:wght@400;500;600;700&display=swap">
<style>
:root{
  --bg:#F1F3F6; --panel:#FFFFFF; --panel-2:#F6F8FA; --panel-3:#EAEEF3;
  --line:#DCE2E9; --line-2:#C2CCD6;
  --ink:#141E28; --ink-2:#4A5A6A; --ink-3:#8090A0;
  --acc:#A8436B; --acc-soft:#FCE9F0; --acc-line:#E2A5BE; --acc-ink:#FFFFFF;
  --ok:#237A4B; --ok-soft:#DFF2E7;
  --warn:#A96E08; --warn-soft:#FAEDD2;
  --bad:#C0353A; --bad-soft:#FBE0E1;
  --info:#2F5AAE; --info-soft:#E1E9F8;
  --shadow:0 1px 2px rgba(18,30,42,.05),0 10px 30px rgba(18,30,42,.10);
  --shadow-sm:0 1px 3px rgba(18,30,42,.10);
  --r:12px; --r-sm:9px;
  --sans:"IBM Plex Sans KR",-apple-system,BlinkMacSystemFont,"Segoe UI","Malgun Gothic",sans-serif;
  --mono:"IBM Plex Mono","D2Coding",ui-monospace,Consolas,monospace;
  --topH:58px; --navH:62px; --tap:44px;
}
@media (prefers-color-scheme:dark){ :root:not([data-theme="light"]){
  --bg:#0C1116; --panel:#151C23; --panel-2:#1B232B; --panel-3:#242E38;
  --line:#2A343F; --line-2:#3B4854;
  --ink:#E6ECF2; --ink-2:#A6B4C1; --ink-3:#71818F;
  --acc:#E692AE; --acc-soft:#31171F; --acc-line:#71384C; --acc-ink:#1D1013;
  --ok:#54C486; --ok-soft:#102A1B;
  --warn:#E0AC4C; --warn-soft:#2E2411;
  --bad:#EE7176; --bad-soft:#301618;
  --info:#87A6F0; --info-soft:#161F34;
  --shadow:0 1px 2px rgba(0,0,0,.5),0 12px 30px rgba(0,0,0,.45);
  --shadow-sm:0 1px 3px rgba(0,0,0,.55);
}}
:root[data-theme="dark"]{
  --bg:#0C1116; --panel:#151C23; --panel-2:#1B232B; --panel-3:#242E38;
  --line:#2A343F; --line-2:#3B4854;
  --ink:#E6ECF2; --ink-2:#A6B4C1; --ink-3:#71818F;
  --acc:#E692AE; --acc-soft:#31171F; --acc-line:#71384C; --acc-ink:#1D1013;
  --ok:#54C486; --ok-soft:#102A1B;
  --warn:#E0AC4C; --warn-soft:#2E2411;
  --bad:#EE7176; --bad-soft:#301618;
  --info:#87A6F0; --info-soft:#161F34;
  --shadow:0 1px 2px rgba(0,0,0,.5),0 12px 30px rgba(0,0,0,.45);
  --shadow-sm:0 1px 3px rgba(0,0,0,.55);
}

*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{height:100%}
body{
  margin:0;background:var(--bg);color:var(--ink);
  font-family:var(--sans);font-size:15px;line-height:1.6;
  -webkit-font-smoothing:antialiased;overscroll-behavior-y:none;
}
button,input,select,textarea{font:inherit;color:inherit}
button{cursor:pointer;border:0;background:none}
:focus-visible{outline:2px solid var(--acc);outline-offset:2px;border-radius:6px}
::-webkit-scrollbar{width:11px;height:11px}
::-webkit-scrollbar-thumb{background:var(--line-2);border-radius:7px;border:3px solid transparent;background-clip:padding-box}
::-webkit-scrollbar-track{background:transparent}
.num{font-family:var(--mono);font-variant-numeric:tabular-nums}
[hidden]{display:none !important}

/* ══ 셸 ══════════════════════════════════════════════════════════ */
#app{display:flex;flex-direction:column;height:100dvh;min-height:0}

#top{
  display:flex;align-items:center;gap:9px;padding:0 12px;min-height:var(--topH);
  background:var(--panel);border-bottom:1px solid var(--line);
  flex:0 0 auto;z-index:40;box-shadow:var(--shadow-sm);
}
.brand{font-weight:700;font-size:17px;letter-spacing:-.4px;flex:0 0 auto;user-select:none}
#top .grow{flex:1 1 auto;min-width:0}

.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:6px;
  min-height:var(--tap);padding:0 15px;background:var(--panel-2);
  border:1px solid var(--line);border-radius:var(--r-sm);
  font-size:15px;font-weight:600;white-space:nowrap;transition:.12s;
}
.btn:hover{background:var(--panel-3)}
.btn:active{transform:scale(.97)}
.btn.pri{background:var(--acc);border-color:var(--acc);color:var(--acc-ink)}
.btn.pri:hover{filter:brightness(1.08)}
.btn.sm{min-height:36px;padding:0 11px;font-size:13.5px;font-weight:500}
.btn.ico{padding:0;width:var(--tap);font-size:20px}
.btn.wide{width:100%}
.btn[disabled]{opacity:.4;pointer-events:none}

select{
  min-height:var(--tap);padding:0 30px 0 12px;background:var(--panel-2);
  border:1px solid var(--line);border-radius:var(--r-sm);
  font-size:15px;font-weight:600;max-width:100%;appearance:none;
  background-image:linear-gradient(45deg,transparent 50%,var(--ink-3) 50%),linear-gradient(135deg,var(--ink-3) 50%,transparent 50%);
  background-position:calc(100% - 17px) calc(50% + 2px),calc(100% - 12px) calc(50% + 2px);
  background-size:5px 5px,5px 5px;background-repeat:no-repeat;
}
input[type=search],input[type=text]{
  min-height:var(--tap);padding:0 12px;background:var(--panel-2);
  border:1px solid var(--line);border-radius:var(--r-sm);font-size:16px;width:100%;
}

/* ══ 본문 ════════════════════════════════════════════════════════ */
#main{flex:1 1 auto;min-height:0;display:grid;grid-template-columns:1fr;overflow:hidden}
.pane{min-height:0;min-width:0;display:none;flex-direction:column;overflow:hidden;background:var(--panel)}
.pane.active{display:flex}
.pane-hd{
  display:flex;align-items:center;gap:8px;padding:9px 12px;flex:0 0 auto;
  border-bottom:1px solid var(--line);background:var(--panel);min-height:52px;
}
.pane-hd h2{margin:0;font-size:16px;font-weight:700;letter-spacing:-.3px}
.pane-bd{flex:1 1 auto;min-height:0;overflow:auto;-webkit-overflow-scrolling:touch}
.pane-ft{flex:0 0 auto;border-top:1px solid var(--line);background:var(--panel);padding:10px 12px}

.seg{display:flex;gap:2px;background:var(--panel-3);padding:3px;border-radius:10px}
.seg button{
  padding:0 14px;min-height:34px;border-radius:8px;font-size:14px;font-weight:600;
  color:var(--ink-2);transition:.12s;
}
.seg button[aria-selected=true]{background:var(--panel);color:var(--ink);box-shadow:var(--shadow-sm)}

/* ══ 하단 탭 ═════════════════════════════════════════════════════ */
#nav{
  display:flex;flex:0 0 auto;min-height:var(--navH);background:var(--panel);
  border-top:1px solid var(--line);padding-bottom:env(safe-area-inset-bottom);z-index:40;
}
#nav button{
  flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;
  color:var(--ink-3);font-size:11.5px;font-weight:600;padding:6px 0;
}
#nav button .g{font-size:20px;line-height:1}
#nav button[aria-selected=true]{color:var(--acc)}

/* ══ 처방표 ══════════════════════════════════════════════════════ */
.phase-hd{
  display:flex;align-items:center;gap:8px;padding:9px 12px;
  background:var(--panel-3);border-bottom:1px solid var(--line);
  font-size:13px;font-weight:700;color:var(--ink-2);position:sticky;top:0;z-index:3;
}
.phase-hd .pdot{width:10px;height:10px;border-radius:3px;flex:0 0 auto}
.phase-hd .amt{margin-left:auto;font-family:var(--mono);font-weight:600;color:var(--ink-3);font-size:12.5px}

.frow{display:flex;align-items:center;gap:10px;padding:9px 12px;border-bottom:1px solid var(--line)}
.frow .nm{flex:1 1 auto;min-width:0;cursor:pointer}
.frow .nm b{display:block;font-size:15px;font-weight:600;line-height:1.35;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.frow .nm small{font-size:12px;color:var(--ink-3);font-family:var(--mono);
  display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.frow .nm .over{color:var(--warn);font-family:var(--sans);font-weight:600}
.frow .gv{font-family:var(--mono);font-size:12px;color:var(--ink-3);
  flex:0 0 auto;width:72px;text-align:right}
.frow .del{width:36px;height:36px;flex:0 0 auto;color:var(--ink-3);font-size:18px;border-radius:8px}
.frow .del:hover{background:var(--bad-soft);color:var(--bad)}

/* ══ 휠 스테퍼 ═══════════════════════════════════════════════════ */
.stp{
  display:inline-flex;align-items:stretch;flex:0 0 auto;
  border:1px solid var(--line);border-radius:10px;background:var(--panel-2);
  overflow:hidden;user-select:none;
}
.stp button{
  width:38px;flex:0 0 auto;font-size:21px;font-weight:400;color:var(--ink-2);
  display:flex;align-items:center;justify-content:center;line-height:1;
}
.stp button:hover{background:var(--panel-3);color:var(--ink)}
.stp button:active{background:var(--acc-soft);color:var(--acc)}
.stp .v{
  min-width:80px;padding:0 4px;display:flex;align-items:center;justify-content:center;gap:2px;
  background:var(--panel);border-left:1px solid var(--line);border-right:1px solid var(--line);
  cursor:ns-resize;position:relative;touch-action:none;
}
.stp .v b{font-family:var(--mono);font-size:16px;font-weight:600;letter-spacing:-.3px}
.stp .v em{font-style:normal;font-size:11px;color:var(--ink-3);font-weight:500}
.stp .v input{
  width:100%;border:0;background:none;text-align:center;font-family:var(--mono);
  font-size:16px;font-weight:600;padding:0;min-height:0;height:100%;
}
.stp.drag .v{background:var(--acc-soft)}
.stp.lg{border-radius:12px}
.stp.lg button{width:54px;font-size:27px}
.stp.lg .v{min-width:124px}
.stp.lg .v b{font-size:25px}
.stp.sm button{width:32px;font-size:18px}
.stp.sm .v{min-width:64px}
.stp.sm .v b{font-size:14px}

/* ══ 원료 고르기 오버레이 ════════════════════════════════════════ */
#picker{position:fixed;inset:0;z-index:120;display:flex;flex-direction:column;
  background:rgba(14,22,30,.45);backdrop-filter:blur(3px)}
#picker .box{
  background:var(--panel);display:flex;flex-direction:column;flex:1 1 auto;min-height:0;
  box-shadow:var(--shadow);
}
#picker .phd{display:flex;align-items:center;gap:10px;padding:10px 12px;
  border-bottom:1px solid var(--line);flex:0 0 auto}
#picker .phd b{font-size:17px;font-weight:700;flex:0 0 auto}
.srch{position:relative;flex:1 1 auto}
.srch input{padding-left:38px;padding-right:40px}
.srch .mag{position:absolute;left:13px;top:50%;transform:translateY(-50%);
  color:var(--ink-3);font-size:17px;pointer-events:none}
.srch .clr{position:absolute;right:5px;top:50%;transform:translateY(-50%);
  width:34px;height:34px;border-radius:8px;color:var(--ink-3);font-size:16px}

.chips{display:flex;gap:7px;padding:9px 12px;overflow-x:auto;scrollbar-width:none;
  border-bottom:1px solid var(--line);flex:0 0 auto}
.chips::-webkit-scrollbar{display:none}
.chip{
  flex:0 0 auto;min-height:36px;padding:0 13px;border-radius:18px;border:1px solid var(--line);
  background:var(--panel-2);font-size:13.5px;font-weight:600;color:var(--ink-2);
  display:inline-flex;align-items:center;gap:6px;
}
.chip[aria-pressed=true]{background:var(--acc-soft);border-color:var(--acc-line);color:var(--acc)}
.chip .dot{width:9px;height:9px;border-radius:50%;flex:0 0 auto}

.ilist{flex:1 1 auto;min-height:0;overflow:auto;-webkit-overflow-scrolling:touch}
.irow{display:flex;align-items:center;gap:11px;padding:10px 12px;border-bottom:1px solid var(--line)}
.irow.on{background:var(--acc-soft)}
.irow .bar{width:4px;align-self:stretch;border-radius:2px;flex:0 0 auto;min-height:40px}
.irow .txt{flex:1 1 auto;min-width:0;cursor:pointer}
.irow .n1{font-size:15px;font-weight:600;line-height:1.35}
.irow .n2{font-size:12px;color:var(--ink-3);font-family:var(--mono);
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.irow .n3{font-size:12.5px;color:var(--ink-2);margin-top:2px;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.irow .act{flex:0 0 auto;display:flex;align-items:center;gap:7px}
.irow .addb{
  min-height:38px;padding:0 14px;border-radius:9px;border:1px solid var(--acc-line);
  background:var(--acc-soft);color:var(--acc);font-weight:700;font-size:13.5px;white-space:nowrap;
}
.irow .addb:hover{background:var(--acc);color:var(--acc-ink)}
.irow .info{width:34px;height:34px;border-radius:8px;color:var(--ink-3);font-size:16px;flex:0 0 auto}
.irow .info:hover{background:var(--panel-3);color:var(--ink)}

.empty{padding:44px 20px;text-align:center;color:var(--ink-3);font-size:15px;line-height:1.9}

/* ══ 공정 ════════════════════════════════════════════════════════ */
.step{border-bottom:1px solid var(--line);padding:11px 12px}
.step-hd{display:flex;align-items:center;gap:10px}
.step-hd .no{
  width:28px;height:28px;border-radius:50%;background:var(--panel-3);color:var(--ink-2);
  font-size:13px;font-weight:700;display:flex;align-items:center;justify-content:center;
  flex:0 0 auto;font-family:var(--mono);
}
.step-hd .ttl{flex:1 1 auto;font-size:15px;font-weight:600;min-width:0}
.step-par{display:flex;flex-wrap:wrap;gap:8px;margin-top:9px;align-items:center}
.parlab{font-size:12px;color:var(--ink-3);font-weight:600}
.step-add{display:flex;flex-wrap:wrap;gap:5px;margin-top:9px}
.tag{font-size:12px;padding:3px 9px;border-radius:12px;background:var(--panel-3);
  color:var(--ink-2);font-weight:500}
.step-note{margin-top:9px;font-size:13px;color:var(--ink-2);line-height:1.65;
  border-left:3px solid var(--line-2);padding-left:10px}

/* ══ 결과 ════════════════════════════════════════════════════════ */
.res{padding:12px}
.hero{
  display:flex;gap:14px;align-items:center;padding:14px;margin-bottom:12px;
  background:var(--panel-2);border:1px solid var(--line);border-radius:var(--r);
}
.hero .info{flex:1 1 auto;min-width:0}
.hero .verdict{font-size:21px;font-weight:700;line-height:1.25;letter-spacing:-.5px}
.hero .sub{font-size:13px;color:var(--ink-2);margin-top:3px}
.hero .badge{display:inline-flex;align-items:center;gap:5px;margin-top:9px;
  padding:5px 12px;border-radius:14px;font-size:12.5px;font-weight:700}
.badge.ok{background:var(--ok-soft);color:var(--ok)}
.badge.bad{background:var(--bad-soft);color:var(--bad)}
.badge.info{background:var(--info-soft);color:var(--info)}

.mets{display:grid;grid-template-columns:repeat(2,1fr);gap:9px}
.met{background:var(--panel);border:1px solid var(--line);border-radius:var(--r-sm);padding:10px 12px}
.met .k{font-size:12px;color:var(--ink-3);font-weight:600}
.met .v{font-family:var(--mono);font-size:22px;font-weight:600;line-height:1.25;letter-spacing:-.6px}
.met .u{font-size:12px;color:var(--ink-3);font-weight:500;margin-left:3px}
.met .r{font-size:11px;color:var(--ink-3);font-family:var(--mono);margin-top:1px}
.met.ok{border-color:var(--ok);background:var(--ok-soft)}
.met.bad{border-color:var(--bad);background:var(--bad-soft)}
.gauge{height:6px;border-radius:3px;background:var(--panel-3);margin-top:7px;position:relative;overflow:hidden}
.gauge .band{position:absolute;top:0;bottom:0;background:var(--ok);opacity:.3}
.gauge .mark{position:absolute;top:-2px;width:3px;height:10px;border-radius:2px;background:var(--ink)}

.acc{border:1px solid var(--line);border-radius:var(--r-sm);margin-top:10px;overflow:hidden;background:var(--panel)}
.acc>summary{
  list-style:none;padding:12px 14px;display:flex;align-items:center;gap:9px;cursor:pointer;
  font-size:14.5px;font-weight:600;background:var(--panel-2);
}
.acc>summary::-webkit-details-marker{display:none}
.acc>summary::after{content:'⌄';margin-left:auto;color:var(--ink-3);font-size:17px;transition:.15s}
.acc[open]>summary::after{transform:rotate(180deg)}
.acc>summary .cnt{font-size:12px;font-weight:700;padding:2px 9px;border-radius:11px;
  background:var(--panel-3);color:var(--ink-2)}
.acc>summary .cnt.bad{background:var(--bad-soft);color:var(--bad)}
.acc>summary .cnt.ok{background:var(--ok-soft);color:var(--ok)}
.acc .body{padding:12px 14px;border-top:1px solid var(--line)}

.note{display:flex;gap:10px;padding:11px 12px;border-radius:var(--r-sm);margin-bottom:8px;
  font-size:13.5px;line-height:1.65;border:1px solid transparent}
.note:last-child{margin-bottom:0}
.note .sv{font-family:var(--mono);font-size:12px;font-weight:700;flex:0 0 auto;padding-top:1px;min-width:26px}
.note b{display:block;font-size:13.5px;margin-bottom:2px}
.note.s3{background:var(--bad-soft);border-color:var(--bad)}
.note.s2{background:var(--warn-soft);border-color:var(--warn)}
.note.s1{background:var(--info-soft);border-color:var(--info)}
.note.good{background:var(--ok-soft);border-color:var(--ok)}

.kv{display:flex;flex-wrap:wrap;gap:7px}
.kv span{font-size:12.5px;font-family:var(--mono);color:var(--ink-2);
  background:var(--panel-2);border:1px solid var(--line);padding:4px 9px;border-radius:7px}

table.rec{width:100%;border-collapse:collapse;font-size:13px;font-family:var(--mono)}
table.rec th{text-align:right;font-weight:700;color:var(--ink-3);padding:6px 7px;
  border-bottom:1px solid var(--line-2);font-size:11.5px}
table.rec th:first-child{text-align:left}
table.rec td{padding:6px 7px;border-bottom:1px solid var(--line);text-align:right;white-space:nowrap}
table.rec td:first-child{text-align:left;font-family:var(--sans);white-space:normal}
table.rec td.hi{color:var(--bad);font-weight:700}
.scroller{overflow-x:auto;-webkit-overflow-scrolling:touch}

.tlrow{display:flex;align-items:center;gap:9px;font-size:12.5px;padding:4px 0}
.tlrow .tt{width:52px;flex:0 0 auto;font-family:var(--mono);color:var(--ink-3);text-align:right}
.tlbar{flex:1 1 auto;height:18px;border-radius:4px;background:var(--panel-3);position:relative;overflow:hidden}
.tlbar i{position:absolute;top:0;bottom:0;border-radius:4px}
.tlrow .tn{width:104px;flex:0 0 auto;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:var(--ink-2)}

/* ══ 학습 ════════════════════════════════════════════════════════ */
.chapter{border-bottom:1px solid var(--line)}
.ch-hd{display:flex;align-items:center;gap:12px;padding:14px 12px;width:100%;text-align:left}
.ch-hd .ic{font-size:24px;flex:0 0 auto;line-height:1}
.ch-hd .t{flex:1 1 auto;min-width:0}
.ch-hd .t b{display:block;font-size:15.5px;font-weight:700}
.ch-hd .t small{font-size:12.5px;color:var(--ink-3)}
.ch-hd .pg{font-family:var(--mono);font-size:13px;color:var(--ink-3);flex:0 0 auto;font-weight:600}
.prog{height:4px;background:var(--panel-3);border-radius:2px;overflow:hidden;margin-top:6px}
.prog i{display:block;height:100%;background:var(--acc);border-radius:2px}
.mrow{display:flex;align-items:center;gap:11px;padding:12px 12px 12px 40px;
  border-top:1px solid var(--line);background:var(--panel-2);width:100%;text-align:left}
.mrow .st{width:28px;height:28px;border-radius:50%;flex:0 0 auto;display:flex;
  align-items:center;justify-content:center;font-size:13px;font-weight:700;
  background:var(--panel-3);color:var(--ink-3);font-family:var(--mono)}
.mrow .st.done{background:var(--ok);color:#fff}
.mrow .tx{flex:1 1 auto;min-width:0}
.mrow .tx b{display:block;font-size:14.5px;font-weight:600}
.mrow .tx small{font-size:12.5px;color:var(--ink-3);display:block}
.mrow .gr{font-family:var(--mono);font-size:17px;font-weight:700;flex:0 0 auto}

.goal{display:flex;gap:10px;align-items:flex-start;padding:8px 0;font-size:14px;line-height:1.6}
.goal .bx{width:20px;height:20px;border-radius:6px;border:2px solid var(--line-2);flex:0 0 auto;
  margin-top:2px;display:flex;align-items:center;justify-content:center;font-size:12px;color:transparent}
.goal.hit .bx{background:var(--ok);border-color:var(--ok);color:#fff}
.goal.opt .bx{border-style:dashed}
.goal .gt{flex:1 1 auto}
.goal .gv{font-family:var(--mono);font-size:12.5px;color:var(--ink-3);white-space:nowrap;font-weight:600}

/* ══ 시트 ════════════════════════════════════════════════════════ */
.mask{position:fixed;inset:0;background:rgba(14,22,30,.5);z-index:130;display:flex;
  align-items:flex-end;justify-content:center;backdrop-filter:blur(3px)}
.sheet{background:var(--panel);width:100%;max-width:640px;max-height:90dvh;
  display:flex;flex-direction:column;border-radius:16px 16px 0 0;box-shadow:var(--shadow);overflow:hidden}
.sheet-hd{display:flex;align-items:center;gap:10px;padding:14px 16px;
  border-bottom:1px solid var(--line);flex:0 0 auto}
.sheet-hd b{flex:1 1 auto;font-size:17px;font-weight:700}
.sheet-bd{flex:1 1 auto;overflow:auto;padding:14px 16px}
.sheet-ft{flex:0 0 auto;padding:12px 16px;border-top:1px solid var(--line);display:flex;gap:9px;
  padding-bottom:calc(12px + env(safe-area-inset-bottom))}
.grab{width:38px;height:5px;border-radius:3px;background:var(--line-2);margin:8px auto 0}

.rt{font-size:15px;line-height:1.8;color:var(--ink-2)}
.rt p{margin:0 0 12px}
.rt b{color:var(--ink);font-weight:600}
.rt code{font-family:var(--mono);font-size:13.5px;background:var(--panel-3);padding:2px 6px;border-radius:5px}
h3.sec{margin:18px 0 8px;font-size:12px;font-weight:700;color:var(--ink-3);letter-spacing:.07em}
h3.sec:first-child{margin-top:0}

.toast{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(var(--navH) + 18px);
  background:var(--ink);color:var(--bg);padding:11px 18px;border-radius:24px;font-size:14px;
  font-weight:600;z-index:200;box-shadow:var(--shadow);max-width:88vw;text-align:center;
  pointer-events:none;animation:tin .2s ease}
@keyframes tin{from{opacity:0;transform:translate(-50%,10px)}to{opacity:1;transform:translate(-50%,0)}}

/* ══ 넓은 화면 ═══════════════════════════════════════════════════ */
.wide-only{display:none}
@media (min-width:980px){
  #nav{display:none}
  .wide-only{display:flex}
  .narrow-only{display:none !important}
  #main{grid-template-columns:minmax(0,1fr) 408px}
  .pane{display:flex}
  .pane[data-col="1"]{grid-column:1;border-right:1px solid var(--line)}
  .pane[data-col="2"]{grid-column:2}
  .mask{align-items:center}
  .sheet{border-radius:16px;max-height:84dvh}
  .grab{display:none}
  .toast{bottom:26px}
  #picker{padding:32px;align-items:center;justify-content:center}
  #picker .box{max-width:780px;width:100%;max-height:84dvh;border-radius:16px;flex:0 1 auto}
  .frow{padding:10px 14px}
  .irow{padding:11px 14px}
}
@media (min-width:1440px){
  #main{grid-template-columns:minmax(0,1fr) 470px}
  .res{padding:16px}
}
@media (max-width:520px){
  #top{flex-wrap:wrap;padding:7px 10px 9px;row-gap:8px}
  .topmid{order:9;flex:1 0 100%;display:flex;gap:8px}
  .topmid select{flex:1 1 auto;min-width:0}
}
@media (min-width:521px){
  .topmid{display:flex;gap:8px;align-items:center;min-width:0}
  .topmid select{max-width:170px}
}
</style>
